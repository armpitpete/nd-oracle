{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nd-oracle.example/schema/object-v0.1.json",
  "title": "ND Oracle knowledge object v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "type", "name", "status", "summary", "scope", "claims", "sources", "uncertainties", "perspectives", "relations", "ecosystem_entry_points", "provenance"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {"$ref": "#/$defs/identifier"},
    "type": {"const": "concept"},
    "name": {"$ref": "#/$defs/nonBlankString"},
    "aliases": {"type": "array", "items": {"$ref": "#/$defs/nonBlankString"}, "uniqueItems": true},
    "status": {"enum": ["seed", "draft", "reviewed", "deprecated"]},
    "summary": {"type": "string", "minLength": 20, "pattern": "\\S"},
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["includes", "excludes"],
      "properties": {"includes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonBlankString"}}, "excludes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonBlankString"}}}
    },
    "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "uncertainties": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/uncertainty"}},
    "perspectives": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/perspective"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "ecosystem_entry_points": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entryPoint"}},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "nonBlankString": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "claim": {"type": "object", "additionalProperties": false, "required": ["id", "text", "confidence", "source_ids", "uncertainty_ids"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "text": {"type": "string", "minLength": 10, "pattern": "\\S"}, "confidence": {"enum": ["high", "moderate", "low", "contested", "not_applicable"]}, "source_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true}, "uncertainty_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true}}},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "citation", "url", "accessed", "supports"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["peer_reviewed", "authoritative_guidance", "community", "lived_experience", "historical", "book", "commercial", "practical", "other"]},
        "citation": {"$ref": "#/$defs/nonBlankString"},
        "url": {"type": "string", "pattern": "^https://"},
        "doi": {"$ref": "#/$defs/nonBlankString"},
        "accessed": {"type": "string", "format": "date"},
        "supports": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        "conflicts_of_interest": {"type": "array", "items": {"$ref": "#/$defs/nonBlankString"}}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "commercial"}}, "required": ["kind"]},
          "then": {"required": ["conflicts_of_interest"]}
        }
      ]
    },
    "uncertainty": {"type": "object", "additionalProperties": false, "required": ["id", "question", "why_it_matters", "what_would_reduce_it", "status"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "question": {"$ref": "#/$defs/nonBlankString"}, "why_it_matters": {"$ref": "#/$defs/nonBlankString"}, "what_would_reduce_it": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonBlankString"}}, "status": {"enum": ["open", "partially_resolved", "none_identified"]}}},
    "perspective": {"type": "object", "additionalProperties": false, "required": ["id", "held_by", "summary", "source_ids"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "held_by": {"$ref": "#/$defs/nonBlankString"}, "summary": {"$ref": "#/$defs/nonBlankString"}, "source_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true}}},
    "relation": {"type": "object", "additionalProperties": false, "required": ["type", "target_id", "note"], "properties": {"type": {"enum": ["broader_than", "narrower_than", "related_to", "commonly_co_occurs_with", "can_affect", "can_support"]}, "target_id": {"$ref": "#/$defs/identifier"}, "note": {"$ref": "#/$defs/nonBlankString"}}},
    "entryPoint": {"type": "object", "additionalProperties": false, "required": ["category", "questions"], "properties": {"category": {"enum": ["tools", "games", "apps", "books_media", "services", "organisations", "communities", "accommodations", "practical_resources"]}, "questions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonBlankString"}}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["created", "created_by", "method", "review_state", "last_reviewed"], "properties": {"created": {"type": "string", "format": "date"}, "created_by": {"$ref": "#/$defs/nonBlankString"}, "method": {"$ref": "#/$defs/nonBlankString"}, "review_state": {"enum": ["unreviewed_seed", "editor_reviewed", "community_reviewed"]}, "last_reviewed": {"type": ["string", "null"], "format": "date"}}}
  }
}

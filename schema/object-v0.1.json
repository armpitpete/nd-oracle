{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nd-oracle.example/schema/object-v0.1.json",
  "title": "ND Oracle knowledge object v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "type", "name", "status", "summary", "scope", "claims", "sources", "uncertainties", "perspectives", "relations", "ecosystem_entry_points", "provenance"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "type": {"enum": ["concept", "resource", "evidence", "uncertainty", "perspective", "organisation", "community", "service", "accommodation", "tool", "game", "app", "media"]},
    "name": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "status": {"enum": ["seed", "draft", "reviewed", "deprecated"]},
    "summary": {"type": "string", "minLength": 20},
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["includes", "excludes"],
      "properties": {"includes": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "excludes": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
    },
    "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "uncertainties": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/uncertainty"}},
    "perspectives": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/perspective"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "ecosystem_entry_points": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entryPoint"}},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "claim": {"type": "object", "additionalProperties": false, "required": ["id", "text", "confidence", "source_ids", "uncertainty_ids"], "properties": {"id": {"type": "string"}, "text": {"type": "string", "minLength": 10}, "confidence": {"enum": ["high", "moderate", "low", "contested", "not_applicable"]}, "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}, "uncertainty_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "citation", "url", "accessed", "supports"], "properties": {"id": {"type": "string"}, "kind": {"enum": ["peer_reviewed", "authoritative_guidance", "community", "lived_experience", "historical", "book", "other"]}, "citation": {"type": "string"}, "url": {"type": "string", "pattern": "^https://"}, "doi": {"type": "string"}, "accessed": {"type": "string", "format": "date"}, "supports": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "uncertainty": {"type": "object", "additionalProperties": false, "required": ["id", "question", "why_it_matters", "what_would_reduce_it", "status"], "properties": {"id": {"type": "string"}, "question": {"type": "string"}, "why_it_matters": {"type": "string"}, "what_would_reduce_it": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "status": {"enum": ["open", "partially_resolved", "none_identified"]}}},
    "perspective": {"type": "object", "additionalProperties": false, "required": ["id", "held_by", "summary", "source_ids"], "properties": {"id": {"type": "string"}, "held_by": {"type": "string"}, "summary": {"type": "string"}, "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "relation": {"type": "object", "additionalProperties": false, "required": ["type", "target_id", "note"], "properties": {"type": {"enum": ["broader_than", "narrower_than", "related_to", "commonly_co_occurs_with", "can_affect", "can_support"]}, "target_id": {"type": "string"}, "note": {"type": "string"}}},
    "entryPoint": {"type": "object", "additionalProperties": false, "required": ["category", "questions"], "properties": {"category": {"enum": ["tools", "games", "apps", "books_media", "services", "organisations", "communities", "accommodations", "practical_resources"]}, "questions": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["created", "created_by", "method", "review_state", "last_reviewed"], "properties": {"created": {"type": "string", "format": "date"}, "created_by": {"type": "string"}, "method": {"type": "string"}, "review_state": {"enum": ["unreviewed_seed", "editor_reviewed", "community_reviewed"]}, "last_reviewed": {"type": ["string", "null"], "format": "date"}}}
  }
}

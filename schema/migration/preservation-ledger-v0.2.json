{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ndoracle.org/schema/migration/preservation-ledger-v0.2.json",
  "title": "ND Oracle migration preservation ledger v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["migration_contract_version", "entries"],
  "properties": {
    "migration_contract_version": {"const": "0.2"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unit", "disposition"],
        "properties": {
          "unit": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["represented_exactly", "represented_with_verified_enrichment", "owner_decision_required", "structural_dependency", "legacy_retained_unmapped", "rejected_with_reason"]},
          "candidate_destination": {"type": ["string", "null"]},
          "enrichment_ref": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]*$"},
          "owner_decision_ref": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]*$"},
          "dependency_ref": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]*$"},
          "unresolved_reason": {"type": ["string", "null"]},
          "legacy_value": {},
          "rejection_reason": {"type": "string", "minLength": 1},
          "reopening_condition": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://ndoracle.org/schema/types/evidence-v0.2.json","title":"ND Oracle evidence object v0.2","type":"object","additionalProperties":false,"required":["schema_version","id","type","status","provenance","title","source_kind","citation","locator","date","date_precision","accessed","authorship","contributions"],"properties":{"schema_version":{"const":"0.2"},"id":{"$ref":"https://ndoracle.org/schema/common-v0.2.json#/$defs/identifier"},"type":{"const":"evidence"},"status":{"$ref":"https://ndoracle.org/schema/common-v0.2.json#/$defs/status"},"provenance":{"$ref":"https://ndoracle.org/schema/common-v0.2.json#/$defs/provenance"},"title":{"$ref":"https://ndoracle.org/schema/common-v0.2.json#/$defs/nonBlankString"},"source_kind":{"enum":["peer_reviewed","authoritative_guidance","community","lived_experience","historical","book","commercial","practical","dataset","other"]},"citation":{"$ref":"https://ndoracle.org/schema/common-v0.2.json#/$defs/nonBlankString"},"locator":{"$ref":"https://ndoracle.org/schema/common-v0.2.json#/$defs/locator"},"date":{"type":"string"},"date_precision":{"enum":["year","month","day"]},"accessed":{"type":"string","format":"date"},"authorship":{"$ref":"https://ndoracle.org/schema/common-v0.2.json#/$defs/nonBlankString"},"conflicts_of_interest":{"type":"array","items":{"$ref":"https://ndoracle.org/schema/common-v0.2.json#/$defs/nonBlankString"}},"funding":{"type":"array","items":{"$ref":"https://ndoracle.org/schema/common-v0.2.json#/$defs/nonBlankString"}},"contributions":{"type":"array","minItems":1,"items":{"$ref":"https://ndoracle.org/schema/common-v0.2.json#/$defs/evidenceContribution"}}},"allOf":[{"if":{"properties":{"source_kind":{"const":"commercial"}},"required":["source_kind"]},"then":{"required":["conflicts_of_interest"]}},{"if":{"properties":{"date_precision":{"const":"year"}},"required":["date_precision"]},"then":{"properties":{"date":{"pattern":"^[0-9]{4}$"}}}},{"if":{"prop